{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YolaCode",
  "version": "0.8.0",
  "identifier": "dev.yola.yolacode",
  "build": {
    "frontendDist": ["../desktop", "../dist"]
  },
  "app": {
    "windows": [
      {
        "title": "YOLA Code",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "label": "main",
        "visible": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "yola-daemon.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
